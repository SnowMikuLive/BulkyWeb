@model int

<div class="container row pt-4">
    <div class="col-12 text-center">
        <h1 class="text-primary text-center">Payment Successful!</h1>
        Your Order Number is : @Model <br /><br />
        <i class="bi bi-check-circle-fill text-success" style="font-size: 8rem;"></i>
    </div>
    <div class="col-12 text-center" style="color:maroon">
        <br />
        Your payment has been processed successfully! <br /><br />
        <a asp-area="Admin"
           asp-controller="Order"
           asp-action="Details"
           asp-route-orderId="@Model"
           class="btn btn-primary">Back to Order Details</a>
    </div>
</div>
