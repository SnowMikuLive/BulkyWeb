@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient py-4">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="py-2 text-white">Manage Profile</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <partial name="_StatusMessage" for="StatusMessage" />
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control" />
                <label asp-for="Input.Name" class="form-label"></label>
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" />
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.StreetAddress" class="form-control" />
                <label asp-for="Input.StreetAddress" class="form-label"></label>
            </div>
            <div class="row">
                <div class="form-floating mb-3 col-md-4">
                    <input asp-for="Input.City" class="form-control" />
                    <label asp-for="Input.City" class="ms-2 form-label"></label>
                </div>
                <div class="form-floating mb-3 col-md-4">
                    <input asp-for="Input.State" class="form-control" />
                    <label asp-for="Input.State" class="ms-2 form-label"></label>
                </div>
                <div class="form-floating mb-3 col-md-4">
                    <input asp-for="Input.PostalCode" class="form-control" />
                    <label asp-for="Input.PostalCode" class="ms-2 form-label"></label>
                </div>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
